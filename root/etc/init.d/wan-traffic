#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
start_service() {
 procd_open_instance
 procd_set_param command /usr/libexec/wan-traffic-worker
 procd_set_param respawn 3600 5 5
 procd_close_instance
 if [ "$(uci -q get wan_traffic.main.web_enabled)" = 1 ]; then
  local address port info
  info=$(/usr/libexec/wan-traffic-web address)
  address=$(printf '%s' "$info" | jsonfilter -e '@.address')
  port=$(printf '%s' "$info" | jsonfilter -e '@.port')
  if [ -n "$address" ] && [ -n "$port" ]; then
   procd_open_instance web
   procd_set_param command /usr/sbin/uhttpd -f -c /dev/null -p "$address:$port" -h /www/wan-traffic -I index.html -x /cgi-bin -S -D -R -n 2 -N 16 -t 15 -T 20 -k 5
   procd_set_param respawn 3600 5 5
   procd_close_instance
  else
   logger -t fluxora 'Standalone panel disabled: LAN IPv4 address or port invalid/unavailable'
  fi
 fi
}
service_triggers() {
 procd_add_reload_trigger wan_traffic
 local iface=$(uci -q get wan_traffic.main.web_interface)
 procd_add_interface_trigger 'interface.*' "${iface:-lan}" /etc/init.d/wan-traffic reload
}
stop_service() {
 /usr/libexec/wan-traffic-api flush >/dev/null
}
