#!/bin/sh
# A read-only API: no arbitrary commands, paths, writes or router sessions.
reject() { printf 'Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\n\r\n{"error":"Request rejected"}\n' "$1"; exit 0; }
[ "$REQUEST_METHOD" = GET ] || reject '405 Method Not Allowed'
[ "$HTTP_HOST" = "$SERVER_ADDR:$SERVER_PORT" ] || reject '403 Forbidden'
[ -z "$HTTP_ORIGIN" ] || [ "$HTTP_ORIGIN" = "http://$HTTP_HOST" ] || reject '403 Forbidden'
case "$QUERY_STRING" in config|status|live) ;; *) reject '404 Not Found';; esac
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nCross-Origin-Resource-Policy: same-origin\r\n\r\n'
if [ "$QUERY_STRING" != config ]; then
 exec /usr/libexec/wan-traffic-api "$QUERY_STRING"
fi
printf '{'
sep=''
for key in reset_day quota_gib quota_mode download_mbps upload_mbps speed_unit refresh_interval motion language; do
 value=$(uci -q get "wan_traffic.main.$key")
 # These presentation values never include network credentials or arbitrary text.
 case "$value" in *[!a-zA-Z0-9_.-]*) value='';; esac
 printf '%s"%s":"%s"' "$sep" "$key" "$value"; sep=','
done
printf '}\n'
